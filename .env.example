# Sao chép file này thành ".env" rồi điền API key của bạn.
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=dien-api-key-cua-ban-vao-day

# Tên mô hình. Nếu báo lỗi "model not found", vào AI Studio xem tên mô hình Flash mới nhất rồi sửa ở đây.
GEMINI_MODEL=gemini-flash-latest

# Địa chỉ API mà giao diện Streamlit sẽ gọi
API_URL=http://127.0.0.1:8000

# Dung lượng file tối đa (MB)
MAX_UPLOAD_MB=10
